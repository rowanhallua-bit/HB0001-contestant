# Copy to .env.local and fill in. Never commit real values.
# Setup guide: docs/KEYS.md

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Bot protection ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000
# Comma-separated origins allowed to call the API (Quinn's frontend)
FRONTEND_ORIGINS=http://localhost:3001
# true only on local/staging. Enables seeded-user demo login. NEVER true in production.
DEMO_MODE=false

# --- Later: AI listing ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Later: Stripe test mode ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Later: scheduled jobs ---
CRON_SECRET=
